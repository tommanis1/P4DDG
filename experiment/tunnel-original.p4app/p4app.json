    ,
      "switches": {
          "s1": {
            "commands": ["s1-runtime-commands.txt"]
            , "mac" : {"python-lambda": "lambda id : f'08:00:00:00:{str(id) if id >= 10 else \"0\" + str(id)}:00'" }
          }
          , "s2": {
            "commands": ["s2-runtime-commands.txt"]
            , "mac" : {"python-lambda": "lambda id : f'08:00:00:00:{str(id) if id >= 10 else \"0\" + str(id)}:00'"}
          }
