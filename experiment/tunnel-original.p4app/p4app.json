{
  "program": "basic_tunnel.p4",
  "language": "p4-16",
//   "cli": true,
  "targets": {
    "multiswitch": {
        "bmv2_log": true,

        "cli":true,
        
        "topo_module": "topo"

        , "auto-control-plane": true

        , "links": [
        [
            "h1",
            "s1"
        ],
        [
            "h2",
            "s2"
        ]
        , [
            "s1",
            "s2"
        ]
