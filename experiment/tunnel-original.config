"multiswitch": {
  "links": [
    ["h1", "s1"],
    ["h2", "s2"],
    ["h3", "s3"],
    
    ["s1", "s2"],
    ["s1", "s3"],

    ["s2", "s1"],

    ["s2", "s3"],

    ["s3", "s1"],
    ["s3", "s2"]
  ],
  "hosts": {
    "h1": {
      "cmd": "python echo_server.py $port",
      "startup_sleep": 0.2,
      "wait": false
    },
    "h2": {
      "cmd": "python echo_client.py h1 $port $echo_msg",
      "wait": true
    }
  },
  "parameters": {
    "port": 8000,
    "echo_msg": "foobar"
  }
  "switches": {
    "s1": {
        table_add MyIngress.ipv4_lpm MyIngress.ipv4_forward hdr.ipv4.dstAddr 10.0.1.1 => 
    },
    "s2": {

    },
    "s3": {

    }
  }
}