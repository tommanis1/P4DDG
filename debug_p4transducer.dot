digraph {
    graph [rankdir=TB];
    node [style=filled
         ,shape=box
         ,fillcolor="#e6f3ff"
         ,color="#4285f4"
         ,fontname=Arial
         ,margin="5.0e-2"];
    edge [style=bold
         ,arrowsize=0.7
         ,color="#666666"];
    0 [label="state_0:\lextract(hdr.ethernet);\l"];
    5 [label="state_5:\l"];
    7 [label="state_7:\l"];
    19 [label="state_19:\l"];
    21 [label="state_21:\l"];
    33 [label="state_33:\l"];
    -1 [label=state_continue];
    0 -> 7 [label=goto
           ,fontname=Arial
           ,fontsize=12];
    7 -> 5 [label="if hdr.ethernet.etherType != TYPE_IPV4"
           ,fontname=Arial
           ,fontsize=12];
    7 -> 21 [label="if hdr.ethernet.etherType == TYPE_IPV4\nextract(hdr.ipv4);\n;\npush(1);"
            ,fontname=Arial
            ,fontsize=12];
    21 -> 19 [label="if hdr.ipv4.protocol != TYPE_TCP"
             ,fontname=Arial
             ,fontsize=12];
    21 -> 33 [label="if hdr.ipv4.protocol == TYPE_TCP\nextract(hdr.tcp);\n;\npush(2);"
             ,fontname=Arial
             ,fontsize=12];
}