digraph {
    graph [rankdir=LR];
    node [style=filled
         ,shape=box
         ,fillcolor="#e6f3ff"
         ,color="#4285f4"
         ,fontname=Arial
         ,margin="5.0e-2"];
    edge [style=bold
         ,arrowsize=0.7
         ,color="#666666"];
    0 [label=0];
    1 [label=1];
    4 [label="4 Output: \"Hdr\""];
    6 [label=6];
    10 [label="10 Output: \"Tunnel\""];
    14 [label=14];
    18 [label=18];
    24 [label=24];
    26 [label=26];
    0 -> 6 [label="hdr.ethernet"
           ,fontname=Arial
           ,fontsize=12];
    1 -> 10 [label=e
            ,fontname=Arial
            ,fontsize=12];
    1 -> 14 [label="[E (Expression {self = \"type == TYPE_IPV4\", exprType = Nothing})]"
            ,fontname=Arial
            ,fontsize=12];
    1 -> 24 [label="[E (Expression {self = \"type == TYPE_TUNNEL\", exprType = Nothing})]"
            ,fontname=Arial
            ,fontsize=12];
    6 -> 1 [label="Tunnel(hdr.ethernet.etherType)"
           ,fontname=Arial
           ,fontsize=12];
    6 -> 4 [label="return: Tunnel(\"hdr.ethernet.etherType\")"
           ,fontname=Arial
           ,fontsize=12];
    14 -> 10 [label="hdr.ipv4"
             ,fontname=Arial
             ,fontsize=12];
    18 -> 10 [label=e
             ,fontname=Arial
             ,fontsize=12];
    24 -> 26 [label="hdr.tunnel"
             ,fontname=Arial
             ,fontsize=12];
    26 -> 1 [label="Tunnel(hdr.tunnel.protoid)"
            ,fontname=Arial
            ,fontsize=12];
    26 -> 18 [label="return: Tunnel(\"hdr.tunnel.protoid\")"
             ,fontname=Arial
             ,fontsize=12];
}